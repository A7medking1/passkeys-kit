# Copy to .env and set your own values.

# The domain your passkeys belong to (no https://). It must serve the two
# .well-known files: this server serves them, if you deploy it there.
RP_ID=example.com
RP_NAME=Passkeys Kit

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/passkeys_kit

# iOS apps that may use the passkeys: TEAMID.bundle.id, comma separated.
IOS_APP_IDS=ABCDE12345.com.example.passkeysKitExample

# The Android app, and the SHA-256 of every key that signs it (debug, upload
# and Play App Signing), comma separated.
ANDROID_PACKAGE=com.example.passkeys_kit_example
ANDROID_SHA256=
