{
  "name": "passkeys-kit-server",
  "version": "0.1.0",
  "description": "Passkey (WebAuthn) sign-in for Express and MongoDB, made for native iOS and Android apps.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "keywords": [
    "passkeys",
    "webauthn",
    "fido2",
    "express",
    "mongodb",
    "flutter",
    "ios",
    "android"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env example/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/example/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "express-rate-limit": "^8.7.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "mongoose": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "express": "^5.3.0",
    "mongoose": "^9.12.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
